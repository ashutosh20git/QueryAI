{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "paper": "#fbf7f0",
    "paperPanel": "#f6f0e5",
    "paperElement": "#f1e9db",
    "paperRule": "#e6dcca",
    "paperRuleStrong": "#ded2be",
    "paperFaint": "#a8998a",
    "paperMuted": "#6b6154",
    "paperInk": "#1f1b16",
    "paperAccent": "#9c4a32",
    "paperPlum": "#6a4a6e",
    "paperSuccess": "#3d5c43",
    "paperWarning": "#9a7420",
    "paperError": "#a02c26",
    "paperInfo": "#3f5771",
    "paperAddBg": "#e8eee6",
    "paperRemoveBg": "#f6e7e4",
    "paperAddNumberBg": "#dde7dc",
    "paperRemoveNumberBg": "#eedcd9",
    "paperLineNumber": "#b8a894",

    "inkBg": "#171310",
    "inkPanel": "#1e1915",
    "inkElement": "#241e18",
    "inkRule": "#322a22",
    "inkRuleStrong": "#443a30",
    "inkFaint": "#6b6055",
    "inkMuted": "#9c8f81",
    "inkText": "#ede4d6",
    "inkAccent": "#d98368",
    "inkPlum": "#b895bd",
    "inkSuccess": "#8fb096",
    "inkWarning": "#d9b063",
    "inkError": "#d97a72",
    "inkInfo": "#8aa6c4",
    "inkAddBg": "#1f2a20",
    "inkRemoveBg": "#2e1c1a",
    "inkAddNumberBg": "#26331f",
    "inkRemoveNumberBg": "#3a2320",
    "inkLineNumber": "#7d7266"
  },
  "theme": {
    "primary": { "dark": "inkAccent", "light": "paperAccent" },
    "secondary": { "dark": "inkPlum", "light": "paperPlum" },
    "accent": { "dark": "inkAccent", "light": "paperAccent" },
    "error": { "dark": "inkError", "light": "paperError" },
    "warning": { "dark": "inkWarning", "light": "paperWarning" },
    "success": { "dark": "inkSuccess", "light": "paperSuccess" },
    "info": { "dark": "inkInfo", "light": "paperInfo" },
    "text": { "dark": "inkText", "light": "paperInk" },
    "textMuted": { "dark": "inkMuted", "light": "paperMuted" },
    "background": { "dark": "inkBg", "light": "paper" },
    "backgroundPanel": { "dark": "inkPanel", "light": "paperPanel" },
    "backgroundElement": { "dark": "inkElement", "light": "paperElement" },
    "backgroundMenu": { "dark": "inkPanel", "light": "paperPanel" },
    "border": { "dark": "inkRuleStrong", "light": "paperRuleStrong" },
    "borderActive": { "dark": "inkAccent", "light": "paperAccent" },
    "borderSubtle": { "dark": "inkRule", "light": "paperRule" },

    "diffAdded": { "dark": "inkSuccess", "light": "paperSuccess" },
    "diffRemoved": { "dark": "inkError", "light": "paperError" },
    "diffContext": { "dark": "inkFaint", "light": "paperFaint" },
    "diffHunkHeader": { "dark": "inkFaint", "light": "paperFaint" },
    "diffHighlightAdded": { "dark": "#a8c9ac", "light": "#2f4c35" },
    "diffHighlightRemoved": { "dark": "#e8938a", "light": "#8c211c" },
    "diffAddedBg": { "dark": "inkAddBg", "light": "paperAddBg" },
    "diffRemovedBg": { "dark": "inkRemoveBg", "light": "paperRemoveBg" },
    "diffContextBg": { "dark": "inkPanel", "light": "paperPanel" },
    "diffLineNumber": { "dark": "inkLineNumber", "light": "paperLineNumber" },
    "diffAddedLineNumberBg": { "dark": "inkAddNumberBg", "light": "paperAddNumberBg" },
    "diffRemovedLineNumberBg": { "dark": "inkRemoveNumberBg", "light": "paperRemoveNumberBg" },

    "markdownText": { "dark": "inkText", "light": "paperInk" },
    "markdownHeading": { "dark": "inkAccent", "light": "paperAccent" },
    "markdownLink": { "dark": "inkAccent", "light": "paperAccent" },
    "markdownLinkText": { "dark": "inkInfo", "light": "paperInfo" },
    "markdownCode": { "dark": "inkSuccess", "light": "paperSuccess" },
    "markdownBlockQuote": { "dark": "inkMuted", "light": "paperMuted" },
    "markdownEmph": { "dark": "inkWarning", "light": "paperWarning" },
    "markdownStrong": { "dark": "inkText", "light": "paperInk" },
    "markdownHorizontalRule": { "dark": "inkRule", "light": "paperRule" },
    "markdownListItem": { "dark": "inkAccent", "light": "paperAccent" },
    "markdownListEnumeration": { "dark": "inkMuted", "light": "paperMuted" },
    "markdownImage": { "dark": "inkAccent", "light": "paperAccent" },
    "markdownImageText": { "dark": "inkInfo", "light": "paperInfo" },
    "markdownCodeBlock": { "dark": "inkText", "light": "paperInk" },

    "syntaxComment": { "dark": "inkFaint", "light": "paperFaint" },
    "syntaxKeyword": { "dark": "inkAccent", "light": "paperAccent" },
    "syntaxFunction": { "dark": "inkInfo", "light": "paperInfo" },
    "syntaxVariable": { "dark": "inkText", "light": "paperInk" },
    "syntaxString": { "dark": "inkSuccess", "light": "paperSuccess" },
    "syntaxNumber": { "dark": "inkWarning", "light": "paperWarning" },
    "syntaxType": { "dark": "inkPlum", "light": "paperPlum" },
    "syntaxOperator": { "dark": "inkMuted", "light": "paperMuted" },
    "syntaxPunctuation": { "dark": "inkMuted", "light": "paperMuted" }
  }
}
