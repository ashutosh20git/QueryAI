      "v2-icon-icon-accent": "#d98368",
      "v2-icon-icon-accent-hover": "#e8a48d",
      "v2-border-border-muted": "#322a22",
      "v2-border-border-base": "#322a22",
      "v2-border-border-strong": "#443a30",
      "v2-border-border-focus": "#d98368",
      "v2-background-bg-accent": "#9c4a32",
      "v2-elevation-raised": "0px 0px 0px 1px #322a22",
      "v2-elevation-floating": "0px 0px 0px 1px #443a30",
      "v2-elevation-overlay": "0px 0px 0px 1px #443a30",
      "v2-elevation-button-neutral": "0px 0px 0px 1px #443a30",
      "v2-elevation-button-contrast": "0px 0px 0px 1px #443a30",
      "v2-elevation-elements": "none",
      "v2-elevation-switch-off": "inset 0px 0px 0px 1px #443a30",
      "v2-elevation-switch-on": "inset 0px 0px 0px 1px #443a30"
    }
  }
}
