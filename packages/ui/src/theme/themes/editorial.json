      "v2-elevation-button-contrast": "0px 0px 0px 1px #1f1b16",
      "v2-elevation-elements": "none",
      "v2-elevation-switch-off": "inset 0px 0px 0px 1px #ded2be",
      "v2-elevation-switch-on": "inset 0px 0px 0px 1px #1f1b16"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#171310",
      "ink": "#ede4d6",
      "primary": "#d98368",
      "interactive": "#d98368",
