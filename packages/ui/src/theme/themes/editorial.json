{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Editorial Warm",
  "id": "editorial",
  "light": {
    "palette": {
      "neutral": "#fbf7f0",
      "ink": "#1f1b16",
      "primary": "#9c4a32",
      "interactive": "#9c4a32",
      "accent": "#6a4a6e",
      "success": "#3d5c43",
      "warning": "#9a7420",
      "error": "#a02c26",
      "info": "#3f5771",
      "diffAdd": "#3d5c43",
      "diffDelete": "#a02c26"
    },
    "overrides": {
      "text-weak": "#6b6154",
      "syntax-comment": "#a8998a",
      "syntax-keyword": "#9c4a32",
      "syntax-string": "#3d5c43",
      "syntax-primitive": "#3f5771",
      "syntax-property": "#3f5771",
      "syntax-type": "#6a4a6e",
      "syntax-constant": "#9a7420",
      "markdown-heading": "#9c4a32",
      "markdown-link": "#9c4a32",
      "markdown-code": "#3d5c43",
      "markdown-block-quote": "#6b6154",
      "markdown-horizontal-rule": "#e6dcca"
    },
    "v2Overrides": {
      "v2-background-bg-base": "#fbf7f0",
      "v2-background-bg-deep": "#f6f0e5",
      "v2-background-bg-layer-01": "#f6f0e5",
      "v2-background-bg-layer-02": "#f1e9db",
      "v2-background-bg-layer-03": "#e6dcca",
      "v2-background-bg-layer-04": "#ded2be",
      "v2-text-text-base": "#1f1b16",
      "v2-text-text-muted": "#6b6154",
      "v2-text-text-faint": "#a8998a",
      "v2-text-text-accent": "#9c4a32",
      "v2-text-text-accent-hover": "#7a3524",
      "v2-text-text-code-accent": "#9c4a32",
      "v2-icon-icon-base": "#6b6154",
      "v2-icon-icon-muted": "#a8998a",
      "v2-icon-icon-accent": "#9c4a32",
      "v2-icon-icon-accent-hover": "#7a3524",
      "v2-border-border-muted": "#e6dcca",
      "v2-border-border-base": "#e6dcca",
      "v2-border-border-strong": "#ded2be",
      "v2-border-border-focus": "#9c4a32",
      "v2-background-bg-accent": "#9c4a32",
      "v2-elevation-raised": "0px 0px 0px 1px #e6dcca",
      "v2-elevation-floating": "0px 0px 0px 1px #ded2be",
